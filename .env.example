# Live AI Teacher Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Teacher Explanation Language ('de' for German, 'en' for English, 'zh' for Chinese)
EXPLAIN_LANGUAGE=de

# Correction Strictness ('gentle', 'normal', 'strict')
CORRECTION_STRICTNESS=normal

# Local Services
TTS_URL=http://127.0.0.1:9880
TUTOR_PORT=8000
